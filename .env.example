# ---------------------------------------------------------------------------
# Supabase (Project Settings → API)
# Leave NEXT_PUBLIC_SUPABASE_URL unset to run in demo mode on the bundled
# sample catalogue (no Supabase project needed). NEXT_PUBLIC_DEMO_MODE=true
# forces demo mode even when Supabase is configured. Uncomment and fill in
# the three Supabase values to connect a project.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only — never expose to the browser or commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo mode only: production builds mark the demo cookies Secure, which browsers
# drop over plain http:// on any host but localhost. Serve the demo over HTTPS,
# or set this to false to open it over plain HTTP (e.g. from a phone on your LAN).
# DEMO_COOKIE_SECURE=false

# Public site URL (used for canonical URLs, sitemap, auth email redirects)
NEXT_PUBLIC_SITE_URL=https://www.auraq.pk

# ---------------------------------------------------------------------------
# Commerce
# ---------------------------------------------------------------------------
# Payment methods offered at checkout (comma separated). Built in: cod, bank_transfer
# A method only appears when it is fully configured (e.g. bank_transfer needs an IBAN).
PAYMENT_METHODS=cod
BANK_TRANSFER_ACCOUNT_TITLE=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_IBAN=
# Tax added on top of prices (0 = prices are tax-inclusive)
TAX_RATE=0
GUEST_CHECKOUT_ENABLED=true

# Allow customers to attach photos to reviews (Supabase Storage "review-images" bucket)
NEXT_PUBLIC_REVIEW_IMAGES_ENABLED=true

# ---------------------------------------------------------------------------
# Cache revalidation
# ---------------------------------------------------------------------------
# Shared secret for POST /api/revalidate (Supabase Database Webhook → refresh
# catalogue/content caches after edits). Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
