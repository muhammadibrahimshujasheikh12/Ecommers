{
  "$description": "AURAQ design tokens (W3C DTCG format). Source of truth for design/prototype/css/tokens.css; names map 1:1 to CSS custom properties (Color / Text / Primary → --color-text-primary) and to the future Tailwind/Next.js theme.",
  "Color": {
    "Background": {
      "Primary":   { "$type": "color", "$value": "#FBF8F3", "$description": "Warm ivory — page background" },
      "Secondary": { "$type": "color", "$value": "#F5EFE6", "$description": "Soft cream — alternate section background" },
      "Tertiary":  { "$type": "color", "$value": "#EFE6D8", "$description": "Warm beige — footer, image wells" },
      "Inverse":   { "$type": "color", "$value": "#2A2826", "$description": "Deep charcoal — primary CTA, bag drawer header" },
      "Overlay":   { "$type": "color", "$value": "#2A282666", "$description": "40% charcoal scrim behind drawers / search" }
    },
    "Pastel": {
      "Blush":    { "$type": "color", "$value": "#F3E3DD" },
      "Rose":     { "$type": "color", "$value": "#D8B4AB", "$description": "Dusty rose — accents, hotspot rings" },
      "Sage":     { "$type": "color", "$value": "#DFE4D5" },
      "Powder":   { "$type": "color", "$value": "#DDE5EB" },
      "Lavender": { "$type": "color", "$value": "#E6E1EC" },
      "Beige":    { "$type": "color", "$value": "#E9DDCB" }
    },
    "Text": {
      "Primary":   { "$type": "color", "$value": "#2A2826", "$description": "14.2:1 on Background/Primary" },
      "Secondary": { "$type": "color", "$value": "#57524C", "$description": "7.6:1 on Background/Primary" },
      "Muted":     { "$type": "color", "$value": "#736C64", "$description": "4.9:1 — minimum for 13px+ text" },
      "Inverse":   { "$type": "color", "$value": "#FBF8F3" },
      "Sale":      { "$type": "color", "$value": "#9A4438", "$description": "Sale price — 6.3:1 on ivory" }
    },
    "Border": {
      "Subtle":  { "$type": "color", "$value": "#E6DDD0" },
      "Default": { "$type": "color", "$value": "#CFC4B5" },
      "Strong":  { "$type": "color", "$value": "#2A2826" }
    },
    "Action": {
      "Primary":       { "$type": "color", "$value": "#2A2826" },
      "Primary Hover": { "$type": "color", "$value": "#45403B" },
      "Secondary Hover": { "$type": "color", "$value": "#2A2826" },
      "Focus":         { "$type": "color", "$value": "#8C6B62" }
    },
    "Status": {
      "Success": { "$type": "color", "$value": "#4F6B4A" },
      "Error":   { "$type": "color", "$value": "#9A4438" },
      "Rating":  { "$type": "color", "$value": "#2A2826" }
    }
  },

  "Font": {
    "Family": {
      "Display": { "$type": "fontFamily", "$value": "Bryn Vogue",  "$description": "Fallback in code: Bodoni Moda, serif" },
      "UI":      { "$type": "fontFamily", "$value": "Jost",        "$description": "Geometric sans. Swap for Futura PT / Neue Haas Unica if licensed" },
      "Body":    { "$type": "fontFamily", "$value": "Open Sans" }
    }
  },

  "Type": {
    "Display": {
      "XL": { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "104px", "lineHeight": "100%", "letterSpacing": "-1%" }, "$description": "Hero campaign name" },
      "L":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "80px",  "lineHeight": "100%", "letterSpacing": "-1%" }, "$description": "Editorial break" }
    },
    "Heading": {
      "XL": { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "60px", "lineHeight": "105%", "letterSpacing": "0%" } },
      "L":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "44px", "lineHeight": "110%", "letterSpacing": "0%" }, "$description": "Section headings" },
      "M":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "34px", "lineHeight": "115%", "letterSpacing": "0%" }, "$description": "Collection names" },
      "S":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "26px", "lineHeight": "120%", "letterSpacing": "0%" }, "$description": "Category tiles, review titles" }
    },
    "UI": {
      "Nav":     { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "500", "fontSize": "13px", "lineHeight": "16px", "letterSpacing": "16%", "textCase": "uppercase" } },
      "Label":   { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "500", "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "20%", "textCase": "uppercase" }, "$description": "Eyebrows, badges" },
      "Button":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "500", "fontSize": "13px", "lineHeight": "16px", "letterSpacing": "18%", "textCase": "uppercase" } },
      "Large":   { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "400", "fontSize": "18px", "lineHeight": "26px", "letterSpacing": "2%" } },
      "Medium":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "500", "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "2%" }, "$description": "Product name" },
      "Price":   { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "400", "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "4%" } },
      "Small":   { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "400", "fontSize": "13px", "lineHeight": "18px", "letterSpacing": "4%" }, "$description": "Collection line under product name" }
    },
    "Body": {
      "Large":   { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Body}", "fontWeight": "400", "fontSize": "17px", "lineHeight": "170%", "letterSpacing": "0%" } },
      "Regular": { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Body}", "fontWeight": "400", "fontSize": "15px", "lineHeight": "165%", "letterSpacing": "0%" } },
      "Small":   { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Body}", "fontWeight": "400", "fontSize": "13px", "lineHeight": "160%", "letterSpacing": "0%" } }
    },
    "Mobile": {
      "Display XL": { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "54px", "lineHeight": "100%", "letterSpacing": "-1%" } },
      "Display L":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "46px", "lineHeight": "102%", "letterSpacing": "-1%" } },
      "Heading L":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "34px", "lineHeight": "110%", "letterSpacing": "0%" } },
      "Heading M":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "28px", "lineHeight": "115%", "letterSpacing": "0%" } },
      "Heading S":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Display}", "fontWeight": "400", "fontSize": "22px", "lineHeight": "120%", "letterSpacing": "0%" } },
      "UI Nav":     { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "500", "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "14%", "textCase": "uppercase" } },
      "UI Medium":  { "$type": "typography", "$value": { "fontFamily": "{Font.Family.UI}", "fontWeight": "500", "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "2%" } },
      "Body Regular": { "$type": "typography", "$value": { "fontFamily": "{Font.Family.Body}", "fontWeight": "400", "fontSize": "15px", "lineHeight": "160%", "letterSpacing": "0%" } }
    }
  },

  "Spacing": {
    "2XS": { "$type": "dimension", "$value": "4px" },
    "XS":  { "$type": "dimension", "$value": "8px" },
    "S":   { "$type": "dimension", "$value": "12px" },
    "M":   { "$type": "dimension", "$value": "16px" },
    "L":   { "$type": "dimension", "$value": "24px" },
    "XL":  { "$type": "dimension", "$value": "32px" },
    "2XL": { "$type": "dimension", "$value": "48px" },
    "3XL": { "$type": "dimension", "$value": "64px" },
    "4XL": { "$type": "dimension", "$value": "96px" },
    "5XL": { "$type": "dimension", "$value": "128px" },
    "Section": {
      "Desktop": { "$type": "dimension", "$value": "128px", "$description": "Vertical padding between homepage sections" },
      "Tablet":  { "$type": "dimension", "$value": "96px" },
      "Mobile":  { "$type": "dimension", "$value": "64px" }
    }
  },

  "Radius": {
    "None": { "$type": "dimension", "$value": "0px",   "$description": "Images, buttons, cards — default" },
    "XS":   { "$type": "dimension", "$value": "2px",   "$description": "Inputs, badges" },
    "S":    { "$type": "dimension", "$value": "4px",   "$description": "Dropdowns, toasts" },
    "Full": { "$type": "dimension", "$value": "999px", "$description": "Colour swatches, icon buttons, bag count" }
  },

  "Shadow": {
    "XS":      { "$type": "shadow", "$value": { "x": "0", "y": "1px",  "blur": "2px",  "spread": "0", "color": "#2A28260A" } },
    "S":       { "$type": "shadow", "$value": { "x": "0", "y": "6px",  "blur": "20px", "spread": "0", "color": "#2A28260F" }, "$description": "Dropdowns, account menu" },
    "Overlay": { "$type": "shadow", "$value": { "x": "0", "y": "24px", "blur": "48px", "spread": "0", "color": "#2A282614" }, "$description": "Mega menu, drawers" }
  },

  "Grid": {
    "Desktop": { "Columns": { "$type": "number", "$value": 12 }, "Margin": { "$type": "dimension", "$value": "64px" }, "Gutter": { "$type": "dimension", "$value": "24px" }, "Frame": { "$type": "dimension", "$value": "1440px" } },
    "Tablet":  { "Columns": { "$type": "number", "$value": 8 },  "Margin": { "$type": "dimension", "$value": "40px" }, "Gutter": { "$type": "dimension", "$value": "20px" }, "Frame": { "$type": "dimension", "$value": "1024px" } },
    "Mobile":  { "Columns": { "$type": "number", "$value": 4 },  "Margin": { "$type": "dimension", "$value": "16px" }, "Gutter": { "$type": "dimension", "$value": "12px" }, "Frame": { "$type": "dimension", "$value": "390px" } }
  },

  "Motion": {
    "Duration": {
      "Fast": { "$type": "duration", "$value": "160ms" },
      "Base": { "$type": "duration", "$value": "280ms" },
      "Slow": { "$type": "duration", "$value": "600ms", "$description": "Image swap, hero crossfade" }
    },
    "Easing": { "Standard": { "$type": "cubicBezier", "$value": [0.22, 0.61, 0.36, 1] } }
  }
}
